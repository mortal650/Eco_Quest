rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if user is teacher
    function isTeacher() {
      return isAuth() && getUserRole() == 'teacher';
    }

    // Helper function to check if user is student
    function isStudent() {
      return isAuth() && getUserRole() == 'student';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if false;

      // User's quiz results subcollection
      match /quiz_results/{resultId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }

      // User's daily challenges subcollection
      match /daily_challenges/{dateKey} {
        allow read: if isAuth();
        allow write: if isAuth();
      }

      // User's mentor conversations subcollection
      match /mentor_conversations/{messageId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    // Modules collection (read-only for students, teachers can read)
    match /modules/{moduleId} {
      allow read: if isAuth();
      allow write: if isTeacher();
    }

    // Classrooms collection
    match /classrooms/{classroomId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      // Only allow joining via classroom code
      function isValidJoin() {
        return isStudent() &&
          request.resource.data.classroomId == resourceId;
      }
    }

    // Classroom members collection
    match /classroom_members/{memberId} {
      allow read: if isAuth();
      allow create: if isStudent();
      allow delete: if isTeacher();
    }

    // Quizzes collection
    match /quizzes/{quizId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Quiz results (top-level collection for teacher analytics)
    match /quiz_results/{resultId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
  }
}
